# Neon PostgreSQL Database Connections
# DATABASE_URL uses the pooled connection string (port 5432 / -pooler)
DATABASE_URL="postgresql://user:password@ep-placeholder-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# DIRECT_URL uses the direct unpooled connection string (required for migrations)
DIRECT_URL="postgresql://user:password@ep-placeholder.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Server configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Authentication Session Secret (used for signing cookies if needed)
SESSION_SECRET="hireflow-super-secret-session-key-change-in-production"

# Persistent Cloud Object Storage for Resumes (Optional for local dev, Required for production Vercel)
# Compatible with AWS S3, Cloudflare R2, Supabase Storage, and MinIO
STORAGE_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
# STORAGE_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com" # Optional: R2 / Supabase endpoint

